# Copy to backend/.env. Everything is optional: with no keys CartPilot runs fully offline.

# --- /parse -------------------------------------------------------------
# auto = Groq when GROQ_API_KEY is set, else Claude Haiku when ANTHROPIC_API_KEY is set,
# else the built-in rule parser. Or force one: rules | groq | anthropic
CARTPILOT_PARSE_PROVIDER=auto
GROQ_API_KEY=
CARTPILOT_GROQ_MODEL=openai/gpt-oss-120b
# Thinking effort for Groq reasoning models (low | medium | high). Leave empty for models without it.
# CARTPILOT_GROQ_REASONING=low
ANTHROPIC_API_KEY=
CARTPILOT_PARSE_MODEL=claude-haiku-4-5

# --- /match -------------------------------------------------------------
# With a key, products are chosen by TypeSafe Jev through an OpenAI-compatible endpoint.
# Without one, the deterministic fuzzy matcher is used.
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_BASE_URL=https://openrouter.ai/api/v1
# To run matching on Groq instead: JEV_API_KEY=<groq key>, JEV_BASE_URL=https://api.groq.com/openai/v1,
# JEV_MODEL=openai/gpt-oss-120b
CARTPILOT_CONFIDENCE_THRESHOLD=0.8
CARTPILOT_SHORTLIST_SIZE=5

# Hosted embeddings for the shortlist (optional; a local embedder is the default).
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://openrouter.ai/api/v1
EMBEDDINGS_MODEL=openai/text-embedding-3-small

# --- /optimize ----------------------------------------------------------
# Search spaces up to this many assignments are solved by exhaustive search, larger ones by ILP.
CARTPILOT_EXHAUSTIVE_LIMIT=200000

CARTPILOT_LLM_TIMEOUT_S=20
CARTPILOT_LOG_LEVEL=INFO
